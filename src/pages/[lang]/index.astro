---
import Base from '../../layouts/Base.astro';
import BluestoveLanding from '../../components/BluestoveLanding.astro';
import type { Lang } from '../../i18n/ui';
import { WIP } from '../../config';

export function getStaticPaths() {
  // Korean copy is kept in the codebase for possible future reuse, but /ko/ is
  // intentionally not generated right now. Keep this route English-only unless
  // the language switcher is restored in BluestoveLanding.astro as well.
  // While WIP is on, emit no language pages at all.
  if (WIP) return [];
  return [{ params: { lang: 'en' } }];
}

const lang = Astro.params.lang as Lang;
---

<Base lang={lang}>
  <main id="main">
    <BluestoveLanding lang={lang} />
  </main>
</Base>
