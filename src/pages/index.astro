---
// The single-page landing lives at "/" — this is the default deploy.
// The WIP placeholder gate is applied AFTER the build (scripts/postbuild.mjs
// swaps dist/index.html and strips the bundle when SITE_WIP=true), so this
// page stays a plain landing entry with no conditional rendering.
import Base from '../layouts/Base.astro';
import BluestoveLanding from '../components/BluestoveLanding.astro';
---

<Base>
  <BluestoveLanding />
</Base>
