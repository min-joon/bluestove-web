---
// Stove + flame logo PLACEHOLDER (coded SVG).
// Brief intent: solid stove silhouette, settles in place with a weighty bob,
// and the flame inside the glass window flickers gently. Final asset TBD —
// this component is isolated so it can be swapped without touching the page.
interface Props {
  /** edge length in px */
  size?: number;
  /** enable the idle bob + flame flicker */
  animated?: boolean;
}
const { size = 200, animated = true } = Astro.props;
---

<div
  class:list={['bs-logo', { 'is-animated': animated }]}
  style={`--logo-size:${size}px`}
  role="img"
  aria-label="Bluestove"
>
  <svg viewBox="0 0 120 140" width={size} height={(size * 140) / 120} aria-hidden="true">
    <defs>
      <radialGradient id="flameGrad" cx="50%" cy="62%" r="60%">
        <stop offset="0%" stop-color="#ffd9a0" />
        <stop offset="35%" stop-color="var(--bs-flame-orange)" />
        <stop offset="100%" stop-color="var(--bs-flame)" />
      </radialGradient>
      <linearGradient id="frameGrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#234a7a" />
        <stop offset="100%" stop-color="var(--bs-navy)" />
      </linearGradient>
    </defs>

    <!-- stove body: solid, single weighty unit -->
    <g class="stove-body">
      <rect x="22" y="14" width="76" height="96" rx="12" fill="url(#frameGrad)"
            stroke="var(--bs-steel-blue)" stroke-width="2.5" />
      <!-- top plate -->
      <rect x="18" y="10" width="84" height="10" rx="5" fill="var(--bs-steel-blue)" />
      <!-- glass window -->
      <rect x="36" y="34" width="48" height="52" rx="9" fill="#081526"
            stroke="var(--bs-navy-darker)" stroke-width="3" />
      <!-- legs -->
      <rect x="32" y="110" width="8" height="18" rx="4" fill="var(--bs-steel-blue)" />
      <rect x="80" y="110" width="8" height="18" rx="4" fill="var(--bs-steel-blue)" />
    </g>

    <!-- flame inside the window: only this part flickers -->
    <g class="flame-group" style="transform-origin: 60px 74px;">
      <ellipse class="flame-glow" cx="60" cy="66" rx="20" ry="24" fill="var(--bs-flame-glow)" />
      <path
        class="flame"
        d="M60 84c-9 0-14-6.2-14-13.6 0-7.3 5.6-10.8 7.4-16.4 2.2 4.2 1.3 7.3 4.6 9.2 1-4.6 4.4-7.8 4.8-13.7 4.6 4.7 11.2 10.2 11.2 20.6C74 78 68.6 84 60 84Z"
        fill="url(#flameGrad)"
      />
      <path
        class="flame-core"
        d="M60 80c-4.4 0-7-3.4-7-7.4 0-4.2 3.8-6.3 4.8-10.2 2.6 3.8 5.9 6.5 5.9 11.2 0 3.8-2.5 6.4-3.7 6.4Z"
        fill="#ffe6bf"
        opacity="0.92"
      />
    </g>
  </svg>
</div>

<style>
  .bs-logo {
    width: var(--logo-size);
    display: inline-block;
    filter: drop-shadow(0 18px 40px rgba(0, 0, 0, 0.45));
  }

  /* Weighty settle: the whole stove bobs once or twice then rests. */
  .is-animated .stove-body {
    animation: stove-settle 6s var(--bs-ease) 0.2s both;
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }

  /* Continuous gentle flicker — only the flame, never the body. */
  .is-animated .flame {
    animation: flame-flicker 2.6s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: 50% 95%;
  }
  .is-animated .flame-core {
    animation: flame-flicker 1.9s ease-in-out infinite reverse;
    transform-box: fill-box;
    transform-origin: 50% 95%;
  }
  .is-animated .flame-glow {
    animation: glow-pulse 3.2s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: 50% 60%;
  }

  @keyframes stove-settle {
    0% { transform: translateY(-14px); }
    18% { transform: translateY(0); }
    30% { transform: translateY(-5px); }
    44% { transform: translateY(0); }
    100% { transform: translateY(0); }
  }

  @keyframes flame-flicker {
    0%, 100% { transform: scaleY(1) scaleX(1) skewX(0deg); opacity: 1; }
    25% { transform: scaleY(1.08) scaleX(0.96) skewX(-2deg); opacity: 0.92; }
    50% { transform: scaleY(0.95) scaleX(1.03) skewX(1.5deg); opacity: 1; }
    75% { transform: scaleY(1.05) scaleX(0.98) skewX(-1deg); opacity: 0.96; }
  }

  @keyframes glow-pulse {
    0%, 100% { opacity: 0.5; transform: scale(1); }
    50% { opacity: 0.85; transform: scale(1.12); }
  }

  @media (prefers-reduced-motion: reduce) {
    .is-animated .stove-body,
    .is-animated .flame,
    .is-animated .flame-core,
    .is-animated .flame-glow {
      animation: none;
    }
  }
</style>
