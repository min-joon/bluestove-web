---
import { ui, brand, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].contact;

// Web3Forms access key is a PUBLIC key (safe in client). The given key is the
// default; PUBLIC_WEB3FORMS_KEY env var can override per environment.
// The recipient (admin@bluestove.com) is configured on the Web3Forms dashboard,
// bound to this key.
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? brand.web3formsKey;

const messages = {
  ok: t.statusOk,
  err: t.statusErr,
  net: t.statusNet,
  unset: t.statusUnset,
};
---

<section class="section contact" id="contact">
  <div class="container contact-grid">
    <div class="contact-copy reveal">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="section-title">{t.title[0]}<br />{t.title[1]}</h2>
      <p class="section-lead" set:html={t.lead.replace(/\n/g, '<br />')} />
      <ul class="contact-meta">
        <li>
          <span>{t.emailLabel}</span>
          <a href={`mailto:${brand.contactEmail}`}>{brand.contactEmail}</a>
        </li>
        <li><span>{t.scopeLabel}</span>{brand.scope}</li>
      </ul>
    </div>

    <form class="contact-form reveal" action="https://api.web3forms.com/submit" method="POST">
      <input type="hidden" name="access_key" value={accessKey} />
      <input type="hidden" name="subject" value={t.subject} />
      <input type="hidden" name="from_name" value="Bluestove Website" />
      <!-- honeypot: bots fill this, humans never see it -->
      <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" />

      <div class="field">
        <label for="cf-name">{t.nameLabel}</label>
        <input id="cf-name" name="name" type="text" required autocomplete="name" placeholder={t.namePh} />
      </div>

      <div class="row">
        <div class="field">
          <label for="cf-email">{t.emailFieldLabel}</label>
          <input id="cf-email" name="email" type="email" required autocomplete="email" placeholder={t.emailPh} />
        </div>
        <div class="field">
          <label for="cf-phone">{t.phoneLabel} <em>{t.phoneOptional}</em></label>
          <input id="cf-phone" name="phone" type="tel" autocomplete="tel" placeholder={t.phonePh} />
        </div>
      </div>

      <div class="field">
        <label for="cf-msg">{t.msgLabel}</label>
        <textarea id="cf-msg" name="message" rows="5" required placeholder={t.msgPh}></textarea>
      </div>

      <button type="submit" class="submit-btn">
        <span class="label">{t.submit}</span>
        <span class="sending">{t.sending}</span>
      </button>

      <p class="form-status" role="status" aria-live="polite" hidden></p>
    </form>
  </div>
</section>

<script define:vars={{ messages }}>
  const form = document.querySelector('.contact-form');
  const status = document.querySelector('.form-status');
  const btn = document.querySelector('.submit-btn');

  if (form && status && btn) {
    const show = (kind, msg) => {
      status.hidden = false;
      status.textContent = msg;
      status.dataset.kind = kind === 'ok' ? 'ok' : 'error';
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const key = data.get('access_key');
      if (!key || key === 'YOUR_WEB3FORMS_ACCESS_KEY') {
        show('error', messages.unset);
        return;
      }
      btn.classList.add('is-sending');
      btn.disabled = true;
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: data,
        });
        const json = await res.json();
        if (res.ok && json.success) {
          form.reset();
          show('ok', messages.ok);
        } else {
          show('error', json.message || messages.err);
        }
      } catch {
        show('error', messages.net);
      } finally {
        btn.classList.remove('is-sending');
        btn.disabled = false;
      }
    });
  }
</script>

<style>
  .contact {
    background: linear-gradient(180deg, var(--bs-navy-deep), var(--bs-navy-darker));
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(36px, 6vw, 72px);
    align-items: start;
  }
  .contact-meta {
    list-style: none;
    margin-top: 30px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .contact-meta li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 0.98rem;
    color: var(--bs-muted-strong);
  }
  .contact-meta span {
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bs-steel-blue-soft);
  }
  .contact-meta a:hover {
    color: var(--bs-flame-orange);
  }

  .contact-form {
    background: var(--bs-card);
    border: 1px solid var(--bs-line);
    border-radius: var(--bs-radius-lg);
    padding: clamp(24px, 3vw, 36px);
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin-bottom: 18px;
  }
  .field label {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--bs-muted-strong);
  }
  .field label em {
    font-style: normal;
    color: var(--bs-muted);
    font-weight: 400;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  input,
  textarea {
    width: 100%;
    font: inherit;
    color: var(--bs-offwhite);
    background: rgba(8, 21, 38, 0.6);
    border: 1px solid var(--bs-line);
    border-radius: 10px;
    padding: 12px 14px;
    transition: border-color 0.25s, background 0.25s;
  }
  input::placeholder,
  textarea::placeholder {
    color: rgba(155, 176, 201, 0.5);
  }
  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--bs-steel-blue);
    background: rgba(8, 21, 38, 0.9);
  }
  textarea {
    resize: vertical;
    min-height: 110px;
  }
  .hp {
    position: absolute;
    left: -9999px;
    opacity: 0;
  }

  .submit-btn {
    position: relative;
    width: 100%;
    margin-top: 6px;
    padding: 15px 24px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 1rem;
    color: #fff;
    background: linear-gradient(135deg, var(--bs-flame-orange), var(--bs-flame));
    box-shadow: 0 10px 30px var(--bs-flame-glow);
    transition: transform 0.2s var(--bs-ease), box-shadow 0.3s, opacity 0.2s;
  }
  .submit-btn:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 16px 40px var(--bs-flame-glow);
  }
  .submit-btn:disabled {
    opacity: 0.7;
    cursor: progress;
  }
  .submit-btn .sending {
    display: none;
  }
  .submit-btn.is-sending .label {
    display: none;
  }
  .submit-btn.is-sending .sending {
    display: inline;
  }

  .form-status {
    margin-top: 16px;
    font-size: 0.94rem;
    padding: 12px 16px;
    border-radius: 10px;
  }
  .form-status[data-kind='ok'] {
    color: #b7f0cf;
    background: rgba(46, 160, 100, 0.12);
    border: 1px solid rgba(46, 160, 100, 0.3);
  }
  .form-status[data-kind='error'] {
    color: #ffc2b5;
    background: rgba(232, 71, 43, 0.1);
    border: 1px solid rgba(232, 71, 43, 0.3);
  }

  @media (max-width: 820px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>
