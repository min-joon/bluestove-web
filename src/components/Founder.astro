---
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].founder;
---

<section class="section founder" id="founder">
  <div class="container founder-grid">
    <div class="founder-aside reveal">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="section-title">{t.title}</h2>
      <div class="founder-card">
        <div class="founder-avatar" aria-hidden="true">許</div>
        <div>
          <p class="founder-name">{t.name}</p>
          <p class="founder-role">{t.role}</p>
        </div>
      </div>
    </div>

    <div class="founder-message reveal">
      <p class="founder-lead">{t.lead}</p>
      {t.body.map((p) => <p>{p}</p>)}
      <p class="founder-sign">{t.sign}</p>
    </div>
  </div>
</section>

<style>
  .founder-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(36px, 6vw, 72px);
    align-items: start;
  }
  .founder-card {
    margin-top: 28px;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px;
    background: var(--bs-card);
    border: 1px solid var(--bs-line);
    border-radius: var(--bs-radius);
  }
  .founder-avatar {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--bs-offwhite);
    background: linear-gradient(135deg, var(--bs-navy), var(--bs-steel-blue));
  }
  .founder-name {
    font-weight: 700;
    font-size: 1.1rem;
  }
  .founder-role {
    color: var(--bs-muted);
    font-size: 0.9rem;
  }
  .founder-message {
    font-size: clamp(1rem, 1.7vw, 1.12rem);
    color: var(--bs-muted-strong);
  }
  .founder-message p + p {
    margin-top: 18px;
  }
  .founder-lead {
    font-size: clamp(1.3rem, 2.8vw, 1.75rem);
    font-weight: 600;
    line-height: 1.4;
    color: var(--bs-offwhite);
    margin-bottom: 26px;
  }
  .founder-sign {
    margin-top: 26px;
    color: var(--bs-flame-orange);
    font-weight: 600;
  }
  @media (max-width: 820px) {
    .founder-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
