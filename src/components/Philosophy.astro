---
import { ui, brand, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].philosophy;
---

<section class="section philosophy" id="philosophy">
  <div class="container">
    <div class="phil-grid">
      <div class="phil-head reveal">
        <p class="eyebrow">{t.eyebrow}</p>
        <h2 class="section-title">
          {t.title[0]}<br />{t.title[1]}
        </h2>
        <blockquote class="phil-quote">{t.quote}</blockquote>
        <p class="phil-motto">
          <span>"</span>{brand.motto}<span>"</span>
          <em>{t.mottoSub}</em>
        </p>
      </div>

      <ol class="phil-timeline reveal">
        {
          t.beats.map((b, i) => (
            <li>
              <span class="beat-no">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{b.era}</h3>
                <p>{b.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .philosophy {
    background: linear-gradient(180deg, var(--bs-navy-darker), var(--bs-navy-deep));
  }
  .phil-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(36px, 6vw, 80px);
    align-items: start;
  }
  .phil-quote {
    margin-top: 24px;
    padding: 18px 22px;
    border-left: 4px solid var(--bs-flame);
    background: var(--bs-card);
    border-radius: 0 var(--bs-radius) var(--bs-radius) 0;
    font-style: italic;
    color: var(--bs-muted-strong);
  }
  .phil-motto {
    margin-top: 28px;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--bs-flame-orange);
  }
  .phil-motto span {
    opacity: 0.5;
  }
  .phil-motto em {
    display: block;
    margin-top: 8px;
    font-size: 0.98rem;
    font-weight: 400;
    font-style: normal;
    color: var(--bs-muted);
  }

  .phil-timeline {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .phil-timeline li {
    display: flex;
    gap: 18px;
    padding: 22px 0;
    border-bottom: 1px solid var(--bs-line);
  }
  .phil-timeline li:last-child {
    border-bottom: none;
  }
  .beat-no {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--bs-flame);
    font-variant-numeric: tabular-nums;
    padding-top: 2px;
  }
  .phil-timeline h3 {
    font-size: 1.08rem;
    font-weight: 600;
    color: var(--bs-offwhite);
  }
  .phil-timeline p {
    margin-top: 6px;
    color: var(--bs-muted);
    font-size: 0.98rem;
  }

  @media (max-width: 820px) {
    .phil-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
