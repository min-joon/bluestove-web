---
// Full-screen "in designing" placeholder shown while the real site is being
// built. Dark theme: the dark-version Blue Stove lockup (mark + wordmark +
// tagline, cropped from the master logo SVG) centered on a deep navy sky, with
// white compass-star twinkles scattered around it.
//   - /logo-dark.svg   dark-version lockup (light mark + "BLUE STOVE" + tagline)
//
// Star positions steer clear of the central column so the logo stays clean.
// [x%, y%, size px]
const stars = [
  [12, 8, 16], [24, 5, 10], [38, 9, 11], [50, 3, 18], [62, 8, 12],
  [76, 6, 14], [88, 10, 9], [30, 15, 8], [70, 14, 9], [6, 14, 9],
  [18, 19, 8], [32, 22, 7], [68, 21, 7], [82, 19, 8],
  [7, 24, 12], [16, 40, 9], [9, 56, 14], [20, 68, 10], [13, 82, 11],
  [5, 38, 9], [24, 54, 8],
  [93, 26, 12], [84, 42, 9], [91, 58, 15], [80, 69, 10], [87, 84, 11],
  [96, 40, 8], [78, 55, 9],
];
---

<main id="main" class="designing" aria-label="Bluestove — site in progress">
  <div class="sky" aria-hidden="true">
    {
      stars.map(([x, y, s], i) => (
        <span
          class="star"
          style={`left:${x}%;top:${y}%;width:${s}px;height:${s}px;animation-delay:${(
            (i * 0.41) %
            3.2
          ).toFixed(2)}s;animation-duration:${(2.8 + (i % 5) * 0.5).toFixed(2)}s`}
        />
      ))
    }
  </div>

  <div class="stack">
    <img
      class="logo"
      src="/logo-dark.svg"
      width="785"
      height="580"
      alt="Blue Stove — an enduring flame with a future mind"
      decoding="async"
    />
    <p class="status">In&nbsp;Designing<span class="dots" aria-hidden="true">…</span></p>
  </div>
</main>

<style>
  .designing {
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 6vh 24px;
    box-sizing: border-box;
    overflow: hidden;
    /* Deep navy night sky with a soft glow toward the upper centre. */
    background:
      radial-gradient(
        120% 90% at 50% 28%,
        #17294a 0%,
        #122038 58%,
        #0d192e 100%
      );
  }

  /* ---- White starlight (compass-star twinkle) ---- */
  .sky {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .star {
    position: absolute;
    display: block;
    background: #ffffff;
    /* four-point sparkle echoing the mark's compass star */
    clip-path: polygon(
      50% 0%,
      60% 40%,
      100% 50%,
      60% 60%,
      50% 100%,
      40% 60%,
      0% 50%,
      40% 40%
    );
    opacity: 0.14;
    transform: scale(0.6);
    animation-name: twinkle;
    animation-iteration-count: infinite;
    animation-timing-function: ease-in-out;
  }

  .stack {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(30px, 5.5vh, 64px);
    animation: rise 0.9s var(--bs-ease) both;
  }

  .logo {
    width: clamp(300px, 52vw, 640px);
    max-width: 100%;
    height: auto;
    display: block;
  }

  .status {
    margin: 0;
    font-family: var(--bs-font-sans);
    font-size: clamp(15px, 2.2vw, 24px);
    font-weight: 500;
    letter-spacing: 0.18em;
    color: #cdd8ea;
    animation: colorPulse 1.9s ease-in-out infinite;
  }

  .dots {
    display: inline-block;
    margin-left: 0.15em;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Stars breathe like distant light. */
  @keyframes twinkle {
    0%,
    100% {
      opacity: 0.14;
      transform: scale(0.55);
    }
    50% {
      opacity: 0.95;
      transform: scale(1);
    }
  }

  /* "In Designing …" fades between dim and bright starlight. */
  @keyframes colorPulse {
    0%,
    100% {
      color: #5f7699;
    }
    50% {
      color: #dbe4f2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stack {
      animation: none;
    }
    .star {
      animation: none;
      opacity: 0.55;
      transform: scale(0.85);
    }
    .status {
      animation: none;
      color: #aeb9cf;
    }
  }
</style>
