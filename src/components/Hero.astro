---
import Logo from './Logo.astro';
import { ui, brand, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].hero;
---

<section class="hero" id="top">
  <div class="hero-bg" aria-hidden="true"></div>

  <div class="container hero-inner">
    <div class="hero-logo">
      <Logo size={210} />
    </div>

    <p class="hero-eyebrow">{t.eyebrow}</p>

    <h1 class="hero-title wordmark">
      <span class="w-blue">Blue</span><span class="w-stove">stove</span>
    </h1>

    <p class="hero-slogan">
      {brand.slogan1}<br />
      <span>{brand.slogan2}</span>
    </p>

    <p class="hero-sub">{t.sub}</p>

    <div class="hero-cta">
      <a class="btn btn-primary" href="#contact">{brand.mottoCta}</a>
      <a class="btn btn-ghost" href="#business">{t.ctaSecondary}</a>
    </div>
  </div>

  <a class="scroll-hint" href="#philosophy" aria-label="scroll down">
    <span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 50% at 50% 38%, rgba(91, 138, 209, 0.16), transparent 70%),
      radial-gradient(40% 30% at 50% 44%, var(--bs-flame-glow), transparent 72%),
      linear-gradient(180deg, var(--bs-navy-deep), var(--bs-navy-darker));
  }
  .hero-inner {
    position: relative;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: 120px 80px;
  }
  .hero-logo {
    margin-bottom: 28px;
  }
  .hero-eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--bs-steel-blue-soft);
    margin-bottom: 14px;
  }
  .hero-title {
    font-size: clamp(2.6rem, 8vw, 5rem);
    line-height: 1;
  }
  .hero-slogan {
    margin-top: 26px;
    font-size: clamp(1.4rem, 3.4vw, 2.3rem);
    font-weight: 300;
    line-height: 1.32;
    color: var(--bs-offwhite);
    font-style: italic;
  }
  .hero-slogan span {
    color: var(--bs-muted-strong);
  }
  .hero-sub {
    margin-top: 22px;
    max-width: 46ch;
    color: var(--bs-muted);
    font-size: clamp(0.95rem, 1.6vw, 1.08rem);
  }
  .hero-cta {
    margin-top: 40px;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.98rem;
    transition: transform 0.2s var(--bs-ease), box-shadow 0.3s var(--bs-ease),
      background 0.3s, border-color 0.3s;
  }
  .btn-primary {
    background: linear-gradient(135deg, var(--bs-flame-orange), var(--bs-flame));
    color: #fff;
    box-shadow: 0 10px 30px var(--bs-flame-glow);
  }
  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 40px var(--bs-flame-glow);
  }
  .btn-ghost {
    border: 1px solid var(--bs-line);
    color: var(--bs-muted-strong);
  }
  .btn-ghost:hover {
    border-color: var(--bs-steel-blue);
    color: var(--bs-offwhite);
    transform: translateY(-2px);
  }

  .scroll-hint {
    position: absolute;
    bottom: 26px;
    left: 50%;
    transform: translateX(-50%);
    width: 26px;
    height: 42px;
    border: 2px solid var(--bs-line);
    border-radius: 14px;
    display: flex;
    justify-content: center;
    padding-top: 7px;
  }
  .scroll-hint span {
    width: 4px;
    height: 8px;
    border-radius: 2px;
    background: var(--bs-steel-blue);
    animation: scroll-dot 1.8s ease-in-out infinite;
  }
  @keyframes scroll-dot {
    0% { opacity: 0; transform: translateY(-4px); }
    40% { opacity: 1; }
    80%, 100% { opacity: 0; transform: translateY(10px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-hint span { animation: none; }
  }
</style>
