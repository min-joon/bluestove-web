---
import { brand } from '../brand';

const year = new Date().getFullYear();
---

<div class="landing">
  <header class="site-header">
    <a class="wordmark" href="#home" aria-label="Bluestove — back to top">Bluestove</a>
    <nav class="site-nav" aria-label="Primary">
      <a href="#home">Home</a>
      <a href="#work">What We Do</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <main id="main" class="snap-pages">
    <section class="page hero-page" id="home" aria-labelledby="hero-title">
      <div class="inner hero-grid">
        <div class="hero-copy">
          <p class="label"><span class="ember" aria-hidden="true"></span>Bluestove · An Operating Company</p>
          <h1 id="hero-title">{brand.slogan}</h1>
          <div class="hero-prose">
            <p>
              The stove was humanity's <strong>first micro power plant</strong> — heat
              contained and turned into usable power. Blue is the colour of
              <strong>future technology</strong>, and of humanity's
              <strong>longing for space</strong>.
            </p>
            <p>
              Because our name carries both meanings, Bluestove today serves as a project
              manager for <strong>AI data centres</strong> and as a
              <strong>deal sponsor</strong>.
            </p>
            <p>
              And we will go further — to become a company that invests in
              <strong>humanity's future technologies and the space industry</strong>.
            </p>
            <p class="hero-aside">contained energy, directed towards what comes next.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="page work-page" id="work" aria-labelledby="work-title">
      <div class="inner work-inner">
        <p class="label center"><span class="ember" aria-hidden="true"></span>What We Do</p>
        <h2 id="work-title">From AI data centres to future technology and space.</h2>

        <div class="work-rows">
          <div class="work-line">
            <p class="row-key" id="work-today">Today</p>
            <ul class="work-row" aria-labelledby="work-today">
              <li>AI Data Centre PM</li>
              <li>Deal Sponsorship</li>
              <li>Consulting / Project Management</li>
            </ul>
          </div>
          <div class="work-line work-line-ahead">
            <p class="row-key" id="work-ahead">Ahead</p>
            <ul class="work-row" aria-labelledby="work-ahead">
              <li>Future Technology Infrastructure</li>
              <li>Space-related Industries</li>
              <li>Long-term Investment in Future Technologies</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="page contact-page" id="contact" aria-labelledby="contact-title">
      <div class="inner contact-grid">
        <div class="contact-copy">
          <p class="label"><span class="ember" aria-hidden="true"></span>Contact</p>
          <h2 id="contact-title">Start a Conversation.</h2>
          <p class="contact-para">
            For conversations around AI data centres, infrastructure, deal sponsorship, or
            future technology investment, Bluestove welcomes thoughtful introductions and
            project inquiries.
          </p>
          <p class="inquiry-line">
            <span>Inquiry areas</span>
            AI data centres, infrastructure, deal sponsorship, future technology investment,
            space-related industry opportunities
          </p>
          <a class="mail-link" href={`mailto:${brand.contactEmail}`}>{brand.contactEmail}</a>
        </div>

        <form class="contact-form" action="https://api.web3forms.com/submit" method="POST">
          <input type="hidden" name="access_key" value={brand.web3formsKey} />
          <input type="hidden" name="subject" value="[Bluestove] New inquiry received" />
          <label>
            <span>Name / Company</span>
            <input name="name" autocomplete="name" />
          </label>
          <label>
            <span>Email</span>
            <input name="email" type="email" required autocomplete="email" />
          </label>
          <label>
            <span>Tell us about the opportunity</span>
            <textarea name="message" rows="5" required></textarea>
          </label>
          <button type="submit">Let's Make it Happen.</button>
        </form>
      </div>

      <footer class="site-footer">
        <span>Bluestove</span>
        <span>{brand.slogan}</span>
        <span>© {year} Bluestove. All rights reserved.</span>
      </footer>
    </section>
  </main>
</div>

<style>
  :global(html) {
    scroll-snap-type: y mandatory;
    scroll-behavior: smooth;
    scroll-padding-top: 0;
  }

  :global(body) {
    background: #05060a;
  }

  .landing {
    position: relative;
    min-height: 100svh;
    color: rgba(238, 243, 249, 0.92);
    background: #05060a;
    isolation: isolate;
  }

  .landing::before,
  .landing::after {
    content: '';
    position: fixed;
    inset: auto;
    z-index: -1;
    pointer-events: none;
    border-radius: 999px;
    filter: blur(22px);
    transform: translate3d(0, 0, 0);
  }

  .landing::before {
    width: min(760px, 82vw);
    height: min(520px, 64vw);
    left: 50%;
    bottom: -22%;
    background:
      radial-gradient(closest-side, rgba(232, 96, 43, 0.16), rgba(91, 138, 209, 0.055) 62%, transparent 78%);
    animation: pulse-ember 7s ease-in-out infinite alternate;
  }

  .landing::after {
    width: min(900px, 96vw);
    height: min(560px, 68vw);
    left: -18%;
    top: -24%;
    background:
      radial-gradient(closest-side, rgba(91, 138, 209, 0.12), rgba(5, 6, 10, 0) 72%);
    animation: pulse-blue 9s ease-in-out infinite alternate;
  }

  .inner {
    width: min(980px, 100%);
    margin-inline: auto;
    padding-inline: clamp(20px, 5vw, 56px);
  }

  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
    padding: 14px clamp(20px, 5vw, 56px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    background: rgba(5, 6, 10, 0.76);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .wordmark {
    color: #fff;
    font-size: 1.08rem;
    font-weight: 740;
    line-height: 1;
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(14px, 3vw, 30px);
    color: rgba(235, 241, 248, 0.62);
    font-size: 0.76rem;
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .site-nav a {
    transition: color 0.2s var(--bs-ease);
  }

  .site-nav a:hover {
    color: #fff;
  }

  .snap-pages {
    position: relative;
  }

  .page {
    min-height: 100svh;
    height: 100svh;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: flex;
    align-items: center;
    padding-block: calc(64px + clamp(28px, 5vh, 54px)) clamp(28px, 5vh, 54px);
    overflow-y: auto;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .label {
    display: inline-flex;
    align-items: center;
    gap: 0.72rem;
    color: rgba(143, 180, 224, 0.92);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .label.center {
    justify-content: center;
    width: 100%;
  }

  .ember {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #8fb4e0;
    box-shadow: 0 0 18px rgba(143, 180, 224, 0.72);
    flex: none;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
  }

  .hero-copy {
    max-width: 760px;
  }

  h1,
  h2 {
    color: #fff;
    letter-spacing: 0;
    text-wrap: balance;
  }

  h1 {
    margin-top: 20px;
    max-width: 16ch;
    font-size: clamp(2.55rem, 7vw, 5.1rem);
    font-weight: 740;
    line-height: 1.05;
  }

  h2 {
    margin-top: 18px;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 720;
    line-height: 1.12;
  }

  .hero-prose {
    margin-top: clamp(22px, 4vh, 34px);
    max-width: 64ch;
    color: rgba(230, 238, 248, 0.72);
  }

  .hero-prose p {
    font-size: clamp(0.98rem, 1.45vw, 1.08rem);
    line-height: 1.78;
  }

  .hero-prose p + p {
    margin-top: 0.8rem;
  }

  .hero-prose strong {
    color: #fff;
    font-weight: 680;
  }

  .hero-aside {
    color: #ff9a52;
    font-style: italic;
  }

  .work-page {
    background: rgba(255, 255, 255, 0.012);
  }

  .work-inner {
    text-align: center;
  }

  .work-rows {
    margin-top: clamp(30px, 6vh, 54px);
    border-top: 1px solid rgba(143, 180, 224, 0.2);
    border-bottom: 1px solid rgba(143, 180, 224, 0.2);
  }

  .work-line {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0.45rem 0.9rem;
    padding: clamp(18px, 3vh, 28px) 0;
    text-align: center;
  }

  .work-line + .work-line {
    border-top: 1px solid rgba(143, 180, 224, 0.16);
  }

  .row-key {
    color: #ff9a52;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .work-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.42rem 0.58rem;
    list-style: none;
  }

  .work-row li {
    color: rgba(238, 243, 249, 0.9);
    font-size: clamp(0.82rem, 1.3vw, 0.96rem);
    font-weight: 720;
    letter-spacing: 0.08em;
    line-height: 1.6;
    text-transform: uppercase;
  }

  .work-line-ahead .work-row li {
    color: rgba(230, 238, 248, 0.62);
  }

  .work-row li:not(:last-child)::after {
    content: '·';
    color: rgba(143, 180, 224, 0.7);
    margin-left: 0.58rem;
  }

  .contact-page {
    position: relative;
    align-items: center;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.82fr);
    gap: clamp(30px, 6vw, 72px);
    align-items: start;
  }

  .contact-para,
  .inquiry-line {
    max-width: 60ch;
    color: rgba(230, 238, 248, 0.68);
    font-size: clamp(0.96rem, 1.35vw, 1.04rem);
    line-height: 1.78;
  }

  .contact-para {
    margin-top: 20px;
  }

  .inquiry-line {
    margin-top: 24px;
  }

  .inquiry-line span {
    display: block;
    margin-bottom: 8px;
    color: rgba(143, 180, 224, 0.92);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .mail-link {
    display: inline-flex;
    margin-top: 22px;
    color: #ff9a52;
    font-weight: 760;
    text-decoration: underline;
    text-decoration-color: rgba(255, 154, 82, 0.42);
    text-underline-offset: 6px;
  }

  .contact-form {
    display: grid;
    gap: 16px;
    padding: clamp(20px, 3vw, 26px);
    border: 1px solid rgba(143, 180, 224, 0.16);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.028);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.035);
  }

  .contact-form label {
    display: grid;
    gap: 8px;
  }

  .contact-form span {
    color: rgba(230, 238, 248, 0.74);
    font-size: 0.84rem;
    font-weight: 680;
  }

  .contact-form input,
  .contact-form textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid rgba(143, 180, 224, 0.2);
    border-radius: 8px;
    background: rgba(2, 8, 16, 0.66);
    color: #fff;
    font: inherit;
  }

  .contact-form textarea {
    resize: vertical;
  }

  .contact-form button {
    width: fit-content;
    min-height: 42px;
    padding: 10px 20px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.94);
    color: #080a10;
    font-size: 0.88rem;
    font-weight: 760;
  }

  .site-footer {
    position: absolute;
    left: clamp(20px, 5vw, 56px);
    right: clamp(20px, 5vw, 56px);
    bottom: 18px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 18px;
    color: rgba(235, 241, 248, 0.42);
    font-size: 0.78rem;
  }

  @keyframes pulse-ember {
    0% {
      opacity: 0.58;
      transform: translate3d(-50%, 2%, 0) scale(0.96);
    }
    100% {
      opacity: 1;
      transform: translate3d(-48%, -2%, 0) scale(1.08);
    }
  }

  @keyframes pulse-blue {
    0% {
      opacity: 0.52;
      transform: translate3d(-1%, 1%, 0) scale(0.98);
    }
    100% {
      opacity: 0.82;
      transform: translate3d(3%, -1%, 0) scale(1.08);
    }
  }

  @media (max-width: 760px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .work-line,
    .work-row {
      flex-direction: column;
      align-items: center;
    }

    .work-row li:not(:last-child)::after {
      content: none;
    }
  }

  @media (max-width: 560px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
      min-height: 86px;
      padding-block: 12px;
    }

    .site-nav {
      width: 100%;
      gap: 16px;
      overflow-x: auto;
      padding-bottom: 2px;
      scrollbar-width: none;
    }

    .site-nav::-webkit-scrollbar {
      display: none;
    }

    .page {
      padding-block: 116px 34px;
    }

    h1 {
      font-size: clamp(2.15rem, 11vw, 3rem);
      line-height: 1.1;
    }

    h2 {
      font-size: clamp(1.75rem, 8vw, 2.4rem);
    }

    .hero-prose p,
    .contact-para,
    .inquiry-line {
      font-size: 0.94rem;
      line-height: 1.68;
    }

    .contact-form {
      gap: 12px;
      padding: 18px;
    }

    .contact-form input,
    .contact-form textarea {
      padding: 10px 12px;
    }

    .contact-form button {
      width: 100%;
    }

    .site-footer {
      position: static;
      margin: 22px clamp(20px, 5vw, 56px) 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }

    .landing::before,
    .landing::after {
      animation: none;
    }

    .site-nav a {
      transition: none;
    }
  }
</style>
