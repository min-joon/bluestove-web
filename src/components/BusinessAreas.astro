---
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].business;
---

<section class="section business" id="business">
  <div class="container">
    <div class="biz-head reveal">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="section-title">{t.title}</h2>
      <p class="section-lead">{t.lead}</p>
    </div>

    <ul class="biz-grid">
      {
        t.areas.map((a) => (
          <li class="biz-card reveal">
            <span class="biz-no">{a.no}</span>
            <h3 class="biz-title">{a.title}</h3>
            {lang === 'ko' && <p class="biz-title-en">{a.titleEn}</p>}
            <p class="biz-desc">{a.desc}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .biz-head {
    margin-bottom: clamp(36px, 5vw, 56px);
  }
  .biz-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .biz-card {
    position: relative;
    padding: 30px 26px 32px;
    background: var(--bs-card);
    border: 1px solid var(--bs-line);
    border-radius: var(--bs-radius-lg);
    overflow: hidden;
    transition: transform 0.3s var(--bs-ease), border-color 0.3s, background 0.3s;
  }
  .biz-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(90deg, var(--bs-flame), var(--bs-flame-orange));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--bs-ease);
  }
  .biz-card:hover {
    transform: translateY(-4px);
    border-color: rgba(91, 138, 209, 0.4);
    background: var(--bs-card-hover);
  }
  .biz-card:hover::before {
    transform: scaleX(1);
  }
  .biz-no {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--bs-flame);
    font-variant-numeric: tabular-nums;
  }
  .biz-title {
    margin-top: 14px;
    font-size: 1.32rem;
    font-weight: 700;
  }
  .biz-title-en {
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bs-steel-blue-soft);
    margin-top: 2px;
  }
  .biz-desc {
    margin-top: 14px;
    color: var(--bs-muted);
    font-size: 0.96rem;
  }

  @media (max-width: 900px) {
    .biz-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .biz-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
