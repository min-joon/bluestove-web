# Web3Forms access key for the Contact form (OPTIONAL override).
# A working public key is already hardcoded as the default in src/i18n/ui.ts
# (brand.web3formsKey), so the form works out of the box. Set this only if you
# want to point a specific environment at a different key.
# The recipient email (admin@bluestove.com) is configured on the Web3Forms
# dashboard, bound to the key — not in code.
# The PUBLIC_ prefix is required for Astro to expose it to the client form.
PUBLIC_WEB3FORMS_KEY=

# Work-in-progress gate. Default (unset) = OFF: build/serve the landing page.
# Set to true only when you want to temporarily expose the placeholder
# ("bluestove.com / work in progress") and hide the real /en page.
SITE_WIP=
